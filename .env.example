# Copy to .env and fill in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=          # optional, free key at https://serper.dev (else DuckDuckGo)
# Optional: any model id CrewAI supports, e.g. anthropic/claude-sonnet-5-5 or openai/gpt-...
LLM_MODEL=openai/gpt-4.1-mini
LLM_MAX_TOKENS=16000
SEARCH_COUNTRY=in        # Google country for Serper searches
LOCK_SETTINGS=false      # true on a public server: visitors cannot change model or keys
MONTHLY_BUDGET_USD=0.30   # hard cap per calendar month (UTC); 0 = no cap
SERPER_COST_PER_CALL=0.001
